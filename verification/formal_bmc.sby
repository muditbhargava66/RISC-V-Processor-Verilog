# Bounded model check of the wrapper contract. Depth 12 covers the canonical
# 12-instruction program; deeper bounds only add NOP-padding cycles whose
# unrolled combinational divider makes the SMT queries very slow. Unbounded
# correctness is established by the prove configs (abc pdr). bitwuzla is far
# faster than yices on this bitvector-heavy circuit.
[options]
mode bmc
depth 12
wait off

[engines]
smtbmc bitwuzla

[script]
read_slang --top riscv_processor_sva -D IVERILOG riscv_pkg.sv alu.sv immediate_generator.sv program_counter.sv register_file.sv instruction_memory.sv data_memory.sv control_unit.sv divider.sv riscv_processor.sv riscv_processor_sva.sv
prep -top riscv_processor_sva -flatten

[files]
../src/riscv_pkg.sv
../src/alu.sv
../src/immediate_generator.sv
../src/program_counter.sv
../src/register_file.sv
../src/instruction_memory.sv
../src/data_memory.sv
../src/control_unit.sv
../src/divider.sv
../src/riscv_processor.sv
riscv_processor_sva.sv
../instruction_memory.hex